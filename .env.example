# Environment Variables Template
# Copy this file to .env and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Server-only (never prefixed VITE_; these must not reach the browser) ─────

# AES-256-GCM key for the Gmail app password in org_secrets.
# Generate with: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=

# HMAC key for recipient-portal links. 32+ characters.
# Generate with: openssl rand -base64 48
PORTAL_TOKEN_SECRET=

# OpenRouter API key for every AI feature (agent, co-founder chat, EdgeBrain,
# library OCR). Read through api/_lib/aiProvider.js. Get one at
# https://openrouter.ai/keys; paid models need credits on the account.
#
# NOT VITE_OPENROUTER_API_KEY. Vite inlines every VITE_-prefixed variable into
# the client bundle as a string literal, which would publish the key to anyone
# who opened devtools.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Optional: the OpenRouter model id every AI feature uses (default
# qwen/qwen3.7-flash). AGENT_MODEL overrides it for the agent only.
# AI_MODEL=qwen/qwen3.7-flash

# Comma-separated origins portal links may be built for. Leave blank to use the
# request's own host (fine for a single deployment).
PORTAL_ALLOWED_ORIGINS=  //

# ── Platform console (/admin) ────────────────────────────────────────────────

# The one account allowed to open the console. /api/admin checks the caller's
# address against this on top of the `platform_admin` claim, so a second account
# that somehow acquires the claim still gets nothing. Leave blank to rely on the
# claim alone.
PLATFORM_ADMIN_EMAIL=nikhil@buddy.com

# The platform's OWN mailbox for console sends — deliberately not any tenant's
# credentials from org_secrets, whose Gmail quota belongs to the customer.
# PLATFORM_SMTP_PASSWORD is a Gmail App Password, not the account password.
PLATFORM_SMTP_USER=portal.agentrive@gmail.com
PLATFORM_SMTP_PASSWORD=
PLATFORM_MAIL_FROM=EdgeOS

# ── Telegram (Buddy as a channel — docs/telegram.md) ─────────────────────────
# Server-only. Never prefix these with VITE_.

# From @BotFather → /newbot. The one platform bot every company connects to.
TELEGRAM_BOT_TOKEN=
# Telegram sends this in X-Telegram-Bot-Api-Secret-Token on every webhook call;
# /api/telegram refuses anything without it. 16–256 chars of A–Z a–z 0–9 _ -.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Optional: the bot's @username without the @ (otherwise read from getMe).
# TELEGRAM_BOT_USERNAME=
# Public HTTPS address of the app, for "Review in StartupBuddy" buttons.
# Falls back to Vercel's production URL when unset.
APP_URL=
# Recommended: Supabase → Project Settings → JWT Keys → Legacy JWT secret.
# Lets the server act as a linked person with a short-lived token of their
# own (RLS applies as in the app). Without it the server obtains one through
# a magic-link exchange (no email is sent), which also works.
SUPABASE_JWT_SECRET=
# Vercel Cron sends this as a bearer token to run the Daily Pulse.
# Generate with: openssl rand -hex 32
CRON_SECRET=
